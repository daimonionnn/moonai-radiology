# ============================================================
#  MONAI Medical Imaging Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── NVIDIA / GPU ────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=all

# ── NGC Credentials — NOT NEEDED by default ─────────────────
# Only required if you re-enable Triton/Holoscan (see docs/OPTIONAL_SERVICES.md).
# Get a key at: https://ngc.nvidia.com → Setup → Generate API Key
# NGC_API_KEY=your_ngc_api_key_here

# ── MONAI Label ─────────────────────────────────────────────
MONAILABEL_PORT=8000
# App options: monaibundle | radiology | pathology | endoscopy
MONAILABEL_APP=monaibundle
# Comma-separated MONAI Zoo bundle names to load
MONAILABEL_MODELS=brats_mri_segmentation,lung_nodule_ct_detection,wholeBody_ct_segmentation,breast_density_classification,pathology_tumor_detection,vista3d
# Studies datastore mode: local | dicomweb
# local      → reads from ./datasets directly (DICOM, NIfTI, NRRD, MHA …)
# dicomweb   → connects to Orthanc DICOMweb at http://orthanc:8042/dicom-web
MONAILABEL_STUDIES_MODE=local
# Path inside container when mode=local
MONAILABEL_STUDIES_LOCAL_PATH=/workspace/datasets
# Preload models into GPU memory at startup
MONAILABEL_PRELOAD=true
# Log level: DEBUG | INFO | WARNING | ERROR
MONAILABEL_LOG_LEVEL=INFO

# ── OHIF Viewer ─────────────────────────────────────────────
OHIF_PORT=3000

# ── Orthanc DICOM Server ────────────────────────────────────
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
ORTHANC_USERNAME=admin
# REQUIRED: choose your own password (start.sh refuses to start with this placeholder)
ORTHANC_PASSWORD=change_me

# ── Triton / Holoscan — REMOVED (see docs/OPTIONAL_SERVICES.md) ─
# TRITON_HTTP_PORT=8010
# TRITON_GRPC_PORT=8001
# TRITON_METRICS_PORT=8002
# HOLOSCAN_PORT=8008

# ── TensorBoard ─────────────────────────────────────────────
TENSORBOARD_PORT=6006

# ── LLM Integration (LM Studio) ─────────────────────────────
# Any OpenAI-compatible server (LM Studio, llama-server, vLLM, Ollama).
# Use the LAN address if the LLM runs on another machine, e.g. http://<host>:1234
LLM_BASE_URL=http://localhost:1234
# Model identifier as shown in LM Studio (e.g. llama-3.1-8b-instruct)
LLM_MODEL=google/gemma-3-27b
LLM_MAX_TOKENS=8192
# Thinking models: 'none' turns reasoning off (faster; the report only verbalizes
# numbers computed in code). Leave empty to use the server default.
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.1

# ── Project Paths (host-side, relative to docker/ directory) ─
HOST_DATASETS_PATH=../datasets
HOST_APPS_PATH=../apps
HOST_MODELS_PATH=../models
HOST_STORAGE_PATH=../storage
