# ── Secrets ─────────────────────────────────────────
docker/.env
*.env
!*.env.example

# ── Scratch / accidentally-committed junk ────────────
datasets/.lock
# Stray control-character filename accidentally committed (an NVIDIA GPG key blob).
# Remove from tracking with:  git rm --cached "$(printf '\004')"


# ── Model storage (large binary files) ──────────────
models/bundles/
models/triton/
models/templates/

# ── Persistent data & logs ───────────────────────────
storage/orthanc-db/
storage/logs/
storage/tensorboard/

# ── Downloaded MONAI Label apps ──────────────────────
apps/

